# Copy to .env and fill in. NEVER commit .env.

# ---- LLM provider (lesson 3 onwards) ----
# Mainland-China deployment: DeepSeek. Other OpenAI-compatible providers can
# be selected by changing only these three variables.
#
# All providers below speak the OpenAI-compatible Chat Completions API,
# so swapping is just three env-var changes — no code change.

# === DeepSeek (recommended for mainland-China deployment) ===
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# === Groq (use outside mainland China) ===
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# === OpenAI (paid, for production demo in lesson 11) ===
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# === OpenRouter (one key, many models) ===
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---- Backend (lesson 9 onwards) ----
# When AI service runs inside docker-compose, point at the compose service name.
# When AI service runs on host (uvicorn --reload), point at localhost.
USTUDENT_BACKEND_URL=http://localhost:8080

# ---- Service ----
AI_SERVICE_PORT=8000
LOG_LEVEL=INFO

# ---- Operations dashboard (/ops) ----
# Empty password disables the dashboard. Use a long random password in .env.
OPS_ADMIN_USERNAME=admin
OPS_ADMIN_PASSWORD=
OPS_DB_PATH=data/ops.sqlite3
OPS_HASH_SALT=replace-with-a-random-private-string
OPS_RETENTION_DAYS=90
# Keep false on an HTTP public-IP deployment. Access /ops through an SSH tunnel.
OPS_ALLOW_INSECURE_HTTP=false
OPS_INSECURE_ALLOWED_CLIENTS=127.0.0.1,::1
# Optional CIDRs for a proxy you control. Direct public requests never trust XFF.
OPS_TRUSTED_PROXY_NETWORKS=
# Optional privacy-minimal JSON access log mounted from front Nginx.
OPS_WEB_ACCESS_LOG_PATH=
OPS_WEB_LOG_MAX_BYTES=100000000
OPS_WEB_CACHE_SECONDS=15
OPS_WEB_ROUTES=/,/login,/dashboard,/ai-chat

# Optional provider price per 1M tokens. Keep at 0 until you copy the current
# prices from your provider; token counts still work and the UI says unconfigured.
LLM_COST_CURRENCY=CNY
LLM_COST_NOTE=
LLM_INPUT_COST_PER_MILLION=0
LLM_CACHED_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
