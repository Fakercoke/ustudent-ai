# Copy to .env — never commit .env, never share it.
#
# LLM provider — Lesson 3 起需要,Lesson 1 只跑 stack 可以留空。
# 中国大陆部署推荐 DeepSeek: https://platform.deepseek.com/api_keys
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# 后端服务地址(docker-compose 内部通信,不用改)
USTUDENT_BACKEND_URL=http://ustudent-backend:8080

# 服务端口
AI_SERVICE_PORT=8000

# 日志详细程度
LOG_LEVEL=INFO
