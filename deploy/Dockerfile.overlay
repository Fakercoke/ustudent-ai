# Fast release path for code-only changes when requirements.txt is unchanged.
# It reuses the already-tested dependency/model layer, replaces all runtime
# source, then rebuilds the Chroma index from the release's data directory.
ARG BASE_IMAGE=ustudent-ai:latest
FROM ${BASE_IMAGE}

# Remove all old runtime source first so deleted files and macOS AppleDouble
# metadata from an earlier image cannot survive an overlay release.
RUN rm -rf /app/app /app/data /app/scripts /app/chroma_db

COPY app/ /app/app/
COPY data/ /app/data/
COPY scripts/ /app/scripts/

RUN python /app/scripts/build_index.py
